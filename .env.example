# APNs token-based auth for server/apns-live-activity.ts.
# Create a key at developer.apple.com → Certificates, IDs & Profiles → Keys (enable APNs).
APNS_TEAM_ID=
APNS_KEY_ID=
# Paste the .p8 contents; newlines may be written as literal \n on one line.
APNS_PRIVATE_KEY=
# The APP's bundle id (not the extension's).
APNS_BUNDLE_ID=com.example.tripactivity
# "production" for TestFlight / App Store builds; anything else = sandbox (dev builds).
APNS_ENVIRONMENT=sandbox
